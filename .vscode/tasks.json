{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Love2D (Linux/macOS)",
      "type": "shell",
      "command": "command -v entr >/dev/null 2>&1 && find . -name '*.lua' | entr -r love . || love .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Love2D (Windows)",
      "type": "shell",
      "command": "C:\\Program Files\\LOVE\\love.exe .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    }
  ]
}